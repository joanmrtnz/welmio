{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",

  "packageConfigurations": {
    "packages/ui": {
      "build": {
        "outputs": ["dist/**"],
        "dependsOn": ["^build"]
      }
    },
    "packages/core": {
      "build": {
        "outputs": ["dist/**"],
        "dependsOn": ["^build"]
      }
    }
  },

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
