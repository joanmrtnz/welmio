# Frontend app URL used to build email verification/reset links
APP_URL="http://localhost:8081"

# API server port
PORT="3000"

# PostgreSQL connection string
DATABASE_URL="postgresql://welmio_user:mock_database_password@localhost:5432/welmio_db?schema=public"

# Secret used to sign JWT access tokens
JWT_SECRET="mock_super_secret_jwt_key_change_me"

# Database password, useful if your Docker/Postgres config reads it separately
DATABASE_PASSWORD="mock_database_password"

# Resend API key used to send emails
RESEND_API_KEY="re_mock_resend_api_key_change_me"

# Verified sender email configured in Resend
MAIL_FROM="Welmio <noreply@welmio.dev>"

# Allowed web origins for CORS, comma-separated
CORS_ORIGIN="http://localhost:8081,https://app.welmio.dev"

# JWT access token expiration time
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"

# Refresh token expiration time in days
REFRESH_TOKEN_EXPIRATION_DAYS="30"