// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  income
  expense
}

enum FrequencyType {
  one_time
  weekly
  monthly
  yearly
}

enum TransactionNature {
  fixed
  variable
  rent
  subscription
  salary
  refund
  other
}

enum AccountType {
  bank
  cash
  credit_card
  debit_card
  savings
  wallet
  investment
}

model User {
  id                      String    @id @default(uuid())
  fullName                String
  email                   String    @unique
  mobileNumber            String?
  dateOfBirth             DateTime?
  password                String
  role                    UserRole  @default(USER)
  avatarIcon  String?
  avatarColor String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  resetPasswordCode       String?
  resetPasswordCodeExpiry DateTime?
  transactions            Transaction[]
  accounts                Account[]
  categories   Category[]
}

model Transaction {
  id                String              @id @default(cuid())
  userId            String
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @db.VarChar(3)
  type              TransactionType
  description       String
  notes             String?
  date              DateTime
  categoryId        String
  accountId         String
  frequencyType     FrequencyType       @default(one_time)
  transactionNature TransactionNature   @default(other)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account           Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date(sort: Desc)])
  @@index([userId, categoryId, date(sort: Desc)])
  @@index([userId, accountId, date(sort: Desc)])
  @@index([userId, currency, date(sort: Desc)])
  @@index([userId, frequencyType])
  @@index([userId, transactionNature])
}

model Account {
  id            String         @id @default(cuid())
  userId        String
  name          String
  type          AccountType
  currencies    String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, name])
}

model Category {
  id            String         @id @default(cuid())
  userId        String
  name          String
  color String?
  icon          String?
  type          TransactionType
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, name, type])
}