// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  income
  expense
}

enum FrequencyType {
  one_time
  weekly
  monthly
  yearly
}

enum TransactionNature {
  fixed
  variable
  rent
  subscription
  salary
  refund
  other
}

enum AccountType {
  bank
  cash
  credit_card
  debit_card
  savings
  wallet
  investment
}

model User {
  id                      String    @id @default(uuid())
  fullName                String
  email                   String    @unique
  mobileNumber            String?
  dateOfBirth             DateTime?
  password                String
  role                    UserRole  @default(USER)
  avatarIcon  String?
  avatarColor String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  emailVerifiedAt         DateTime?
  pendingEmail            String?
  resetPasswordCode       String?
  resetPasswordCodeExpiry DateTime?
  transactions            Transaction[]
  accounts                Account[]
  categories              Category[]
  goals                   Goal[]
  goalContributions GoalContribution[]
  verificationTokens VerificationToken[]
  refreshTokens RefreshToken[]
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum VerificationTokenType {
  email_verification
  email_change
  password_reset
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  replacedByTokenHash String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Transaction {
  id                String              @id @default(cuid())
  userId            String
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @db.VarChar(3)
  type              TransactionType
  description       String
  notes             String?
  date              DateTime
  categoryId        String
  accountId         String
  frequencyType     FrequencyType       @default(one_time)
  transactionNature TransactionNature   @default(other)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account           Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)

  goalContributions GoalContribution[]

  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date(sort: Desc)])
  @@index([userId, categoryId, date(sort: Desc)])
  @@index([userId, accountId, date(sort: Desc)])
  @@index([userId, currency, date(sort: Desc)])
  @@index([userId, frequencyType])
  @@index([userId, transactionNature])
}

model Account {
  id            String         @id @default(cuid())
  userId        String
  name          String
  type          AccountType
  currencies    String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, name])
}

model Category {
  id            String         @id @default(cuid())
  userId        String
  name          String
  color String?
  icon          String?
  type          TransactionType
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([userId, name, type])
}

enum GoalStatus {
  active
  completed
  paused
  cancelled
}

enum GoalType {
  savings
  debt_payment
  emergency_fund
  purchase
  investment
  other
}

model Goal {
  id             String      @id @default(cuid())
  userId         String

  name           String
  description    String?

  targetAmount   Decimal     @db.Decimal(12, 2)
  currentAmount  Decimal     @default(0) @db.Decimal(12, 2)
  currency       String      @db.VarChar(3)

  targetDate     DateTime?
  startDate      DateTime    @default(now())

  type           GoalType    @default(savings)
  status         GoalStatus  @default(active)

  icon           String?
  color          String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions  GoalContribution[]

  @@index([userId, status])
  @@index([userId, targetDate])
  @@index([userId, currency])
}

model GoalContribution {
  id             String       @id @default(cuid())
  goalId         String
  userId         String

  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @db.VarChar(3)

  date           DateTime     @default(now())
  notes          String?

  transactionId  String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  goal           Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date(sort: Desc)])
  @@index([userId, date(sort: Desc)])
  @@index([transactionId])
}
